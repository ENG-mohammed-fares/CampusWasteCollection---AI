<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.LineChart?>
<?import javafx.scene.control.NumberAxis?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campuswaste.ui.PerceptronController"
            prefWidth="1280" prefHeight="800"
            stylesheets="@../css/dashboard.css">

    <left>
        <VBox prefWidth="235" spacing="30" styleClass="sidebar">
            <padding>
                <Insets top="30" right="20" bottom="25" left="20"/>
            </padding>

            <VBox spacing="4">
                <Label text="CAMPUS" styleClass="brand-title"/>
                <Label text="WASTE AI" styleClass="brand-subtitle"/>
            </VBox>

            <VBox spacing="12">
                <Label text="WORKSPACE" styleClass="section-caption"/>
                <Label text="Overview" styleClass="nav-active"/>
                <Label text="Perceptron" styleClass="nav-item"/>
                <Label text="Route Planning" styleClass="nav-item"/>
                <Label text="Reports" styleClass="nav-item-disabled"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="5">
                <Label text="CAMPUS COLLECTION" styleClass="footer-title"/>
                <Label text="AI-powered waste management"
                       styleClass="footer-note"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="content">
            <padding>
                <Insets top="28" right="30" bottom="26" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="5">
                    <Label text="Campus Waste Collection" styleClass="page-title"/>
                    <Label text="Perceptron training, evaluation and bin prediction."
                           styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="5">
                    <Label text="SYSTEM STATUS" styleClass="status-caption"/>
                    <Label fx:id="systemStatusLabel"
                           text="WAITING FOR DATA"
                           styleClass="status-pill"/>
                </VBox>
            </HBox>

            <TabPane tabClosingPolicy="UNAVAILABLE"
                     VBox.vgrow="ALWAYS"
                     styleClass="main-tabs">

                <tabs>
                    <Tab text="Overview">
                        <content>
                            <VBox spacing="18" styleClass="tab-content">
                                <HBox spacing="14">
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="TOTAL BINS" styleClass="stat-label"/>
                                        <Label text="--" styleClass="stat-value"/>
                                        <Label text="No campus bin records loaded"
                                               styleClass="stat-note"/>
                                    </VBox>

                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="NEED PICKUP" styleClass="stat-label"/>
                                        <Label text="--" styleClass="stat-value"/>
                                        <Label text="Awaiting live bin predictions"
                                               styleClass="stat-note"/>
                                    </VBox>

                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="ACTIVE ROUTES" styleClass="stat-label"/>
                                        <Label text="--" styleClass="stat-value"/>
                                        <Label text="Route planning connected"
                                               styleClass="stat-note"/>
                                    </VBox>

                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="TOTAL DISTANCE" styleClass="stat-label"/>
                                        <Label text="--" styleClass="stat-value"/>
                                        <Label text="Awaiting route calculation"
                                               styleClass="stat-note"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="18" VBox.vgrow="ALWAYS">
                                    <VBox styleClass="panel" spacing="18"
                                          HBox.hgrow="ALWAYS">
                                        <Label text="Collection Overview"
                                               styleClass="panel-title"/>
                                        <Separator/>
                                        <VBox alignment="CENTER" spacing="12"
                                              VBox.vgrow="ALWAYS">
                                            <Label text="No campus bin records loaded"
                                                   styleClass="empty-title"/>
                                            <Label text="Training and test CSV rows are model samples, not live campus bin records. Load operational bin data in a later integration stage."
                                                   wrapText="true"
                                                   styleClass="empty-description"/>
                                        </VBox>
                                    </VBox>

                                    <VBox styleClass="panel" prefWidth="300"
                                          spacing="16">
                                        <Label text="AI ENGINE" styleClass="panel-title"/>
                                        <Separator/>
                                        <Label text="01  PERCEPTRON"
                                               styleClass="algorithm-title"/>
                                        <Label text="Train the model, evaluate it on the separate test dataset, and predict individual bin readings."
                                               wrapText="true"
                                               styleClass="algorithm-description"/>
                                        <Label fx:id="perceptronOverviewStatusLabel"
                                               text="NOT TRAINED"
                                               styleClass="pending-tag"/>
                                        <Separator/>
                                        <Label text="02  SIMULATED ANNEALING"
                                               styleClass="algorithm-title"/>
                                        <Label text="Use the Route Planning tab to create bins and calculate a collection route."
                                               wrapText="true"
                                               styleClass="algorithm-description"/>
                                        <Label text="CONNECTED"
                                               styleClass="pending-tag"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>

                    <Tab text="Perceptron">
                        <content>
                            <ScrollPane fitToWidth="true"
                                        hbarPolicy="NEVER"
                                        styleClass="content-scroll">
                                <content>
                                    <VBox spacing="18" styleClass="tab-content">
                                        <Label fx:id="errorMessageLabel"
                                               text=""
                                               visible="false"
                                               managed="false"
                                               wrapText="true"
                                               styleClass="error-message"/>

                                        <VBox styleClass="panel" spacing="14">
                                            <VBox spacing="4">
                                                <Label text="Dataset Selection"
                                                       styleClass="panel-title"/>
                                                <Label text="Select the training and test CSV files separately. The test dataset is used only for evaluation."
                                                       wrapText="true"
                                                       styleClass="section-description"/>
                                            </VBox>
                                            <Separator/>
                                            <GridPane hgap="12" vgap="12">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="50"/>
                                                    <ColumnConstraints percentWidth="50"/>
                                                </columnConstraints>
                                                <VBox spacing="8" GridPane.columnIndex="0"
                                                      GridPane.rowIndex="0">
                                                    <Label text="TRAINING DATASET"
                                                           styleClass="field-caption"/>
                                                    <Button text="Choose training CSV"
                                                            onAction="#selectTrainingDataset"
                                                            styleClass="secondary-button"
                                                            maxWidth="Infinity"/>
                                                    <Label fx:id="trainingFileLabel"
                                                           text="No training file selected"
                                                           wrapText="true"
                                                           styleClass="file-name"/>
                                                    <Label fx:id="trainingSampleCountLabel"
                                                           text="0 training samples"
                                                           styleClass="field-note"/>
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="1"
                                                      GridPane.rowIndex="0">
                                                    <Label text="TEST DATASET"
                                                           styleClass="field-caption"/>
                                                    <Button text="Choose test CSV"
                                                            onAction="#selectTestDataset"
                                                            styleClass="secondary-button"
                                                            maxWidth="Infinity"/>
                                                    <Label fx:id="testFileLabel"
                                                           text="No test file selected"
                                                           wrapText="true"
                                                           styleClass="file-name"/>
                                                    <Label fx:id="testSampleCountLabel"
                                                           text="0 test samples"
                                                           styleClass="field-note"/>
                                                </VBox>
                                            </GridPane>
                                            <HBox alignment="CENTER_LEFT" spacing="12">
                                                <Button fx:id="trainAndTestButton"
                                                        text="Train and Test"
                                                        onAction="#trainAndTest"
                                                        disable="true"
                                                        styleClass="primary-button"/>
                                                <Label text="MODEL STATUS" styleClass="field-caption"/>
                                                <Label fx:id="modelStatusLabel"
                                                       text="NOT TRAINED"
                                                       styleClass="pending-tag"/>
                                            </HBox>
                                            <Label fx:id="workflowStatusLabel"
                                                   text="Select both CSV files to begin."
                                                   wrapText="true"
                                                   styleClass="status-message"/>
                                            <Label fx:id="convergenceWarningLabel"
                                                   text=""
                                                   visible="false"
                                                   managed="false"
                                                   wrapText="true"
                                                   styleClass="warning-message"/>
                                        </VBox>

                                        <VBox styleClass="panel" spacing="14">
                                            <Label text="Evaluation Results"
                                                   styleClass="panel-title"/>
                                            <Label text="Metrics are calculated from the test dataset only."
                                                   styleClass="section-description"/>
                                            <Separator/>
                                            <GridPane hgap="12" vgap="12">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="25"/>
                                                    <ColumnConstraints percentWidth="25"/>
                                                    <ColumnConstraints percentWidth="25"/>
                                                    <ColumnConstraints percentWidth="25"/>
                                                </columnConstraints>
                                                <VBox styleClass="metric-card"
                                                      GridPane.columnIndex="0"
                                                      GridPane.rowIndex="0">
                                                    <Label text="TEST ACCURACY"
                                                           styleClass="metric-caption"/>
                                                    <Label fx:id="accuracyValue"
                                                           text="--"
                                                           styleClass="metric-value"/>
                                                </VBox>
                                                <VBox styleClass="metric-card"
                                                      GridPane.columnIndex="1"
                                                      GridPane.rowIndex="0">
                                                    <Label text="MISSED PICKUPS"
                                                           styleClass="metric-caption"/>
                                                    <Label fx:id="missedPickupsValue"
                                                           text="--"
                                                           styleClass="metric-value"/>
                                                </VBox>
                                                <VBox styleClass="metric-card"
                                                      GridPane.columnIndex="2"
                                                      GridPane.rowIndex="0">
                                                    <Label text="FALSE PICKUP ALERTS"
                                                           styleClass="metric-caption"/>
                                                    <Label fx:id="falseAlertsValue"
                                                           text="--"
                                                           styleClass="metric-value"/>
                                                </VBox>
                                                <VBox styleClass="metric-card"
                                                      GridPane.columnIndex="3"
                                                      GridPane.rowIndex="0">
                                                    <Label text="TEST SAMPLES"
                                                           styleClass="metric-caption"/>
                                                    <Label fx:id="testSamplesValue"
                                                           text="--"
                                                           styleClass="metric-value"/>
                                                </VBox>
                                            </GridPane>
                                            <GridPane hgap="12" vgap="8">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="25"/>
                                                    <ColumnConstraints percentWidth="25"/>
                                                    <ColumnConstraints percentWidth="25"/>
                                                    <ColumnConstraints percentWidth="25"/>
                                                </columnConstraints>
                                                <Label text="True positives"
                                                       styleClass="result-label"
                                                       GridPane.columnIndex="0"
                                                       GridPane.rowIndex="0"/>
                                                <Label fx:id="truePositivesValue"
                                                       text="--"
                                                       styleClass="result-value"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="0"/>
                                                <Label text="True negatives"
                                                       styleClass="result-label"
                                                       GridPane.columnIndex="2"
                                                       GridPane.rowIndex="0"/>
                                                <Label fx:id="trueNegativesValue"
                                                       text="--"
                                                       styleClass="result-value"
                                                       GridPane.columnIndex="3"
                                                       GridPane.rowIndex="0"/>
                                                <Label text="False positives"
                                                       styleClass="result-label"
                                                       GridPane.columnIndex="0"
                                                       GridPane.rowIndex="1"/>
                                                <Label fx:id="falsePositivesValue"
                                                       text="--"
                                                       styleClass="result-value"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="1"/>
                                                <Label text="False negatives"
                                                       styleClass="result-label"
                                                       GridPane.columnIndex="2"
                                                       GridPane.rowIndex="1"/>
                                                <Label fx:id="falseNegativesValue"
                                                       text="--"
                                                       styleClass="result-value"
                                                       GridPane.columnIndex="3"
                                                       GridPane.rowIndex="1"/>
                                            </GridPane>
                                            <HBox spacing="24">
                                                <Label fx:id="epochsValue"
                                                       text="Epochs: --"
                                                       styleClass="result-label"/>
                                                <Label fx:id="convergenceValue"
                                                       text="Training status: --"
                                                       styleClass="result-label"/>
                                            </HBox>
                                        </VBox>

                                        <VBox styleClass="panel" spacing="14">
                                            <VBox spacing="4">
                                                <Label text="Predict One Bin"
                                                       styleClass="panel-title"/>
                                                <Label text="Enter the three readings in the exact feature order shown by the training CSV header."
                                                       wrapText="true"
                                                       styleClass="section-description"/>
                                            </VBox>
                                            <Separator/>
                                            <GridPane hgap="12" vgap="8">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="33.33"/>
                                                    <ColumnConstraints percentWidth="33.33"/>
                                                    <ColumnConstraints percentWidth="33.34"/>
                                                </columnConstraints>
                                                <Label fx:id="reading1Label"
                                                       text="Reading 1"
                                                       styleClass="field-caption"
                                                       GridPane.columnIndex="0"
                                                       GridPane.rowIndex="0"/>
                                                <Label fx:id="reading2Label"
                                                       text="Reading 2"
                                                       styleClass="field-caption"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="0"/>
                                                <Label fx:id="reading3Label"
                                                       text="Reading 3"
                                                       styleClass="field-caption"
                                                       GridPane.columnIndex="2"
                                                       GridPane.rowIndex="0"/>
                                                <TextField fx:id="reading1Field"
                                                           promptText="Enter value"
                                                           GridPane.columnIndex="0"
                                                           GridPane.rowIndex="1"/>
                                                <TextField fx:id="reading2Field"
                                                           promptText="Enter value"
                                                           GridPane.columnIndex="1"
                                                           GridPane.rowIndex="1"/>
                                                <TextField fx:id="reading3Field"
                                                           promptText="Enter value"
                                                           GridPane.columnIndex="2"
                                                           GridPane.rowIndex="1"/>
                                            </GridPane>
                                            <HBox alignment="CENTER_LEFT" spacing="12">
                                                <Button fx:id="predictButton"
                                                        text="Predict"
                                                        onAction="#predictSingleBin"
                                                        disable="true"
                                                        styleClass="primary-button"/>
                                                <Label fx:id="predictionValue"
                                                       text="No prediction yet"
                                                       styleClass="prediction-result"/>
                                            </HBox>
                                            <Label fx:id="currentFillStatusValue"
                                                   text="Current fill: --"
                                                   styleClass="result-label"/>
                                            <Label fx:id="predictionMessageLabel"
                                                   text=""
                                                   visible="false"
                                                   managed="false"
                                                   wrapText="true"
                                                   styleClass="error-message"/>
                                            <Label text="The feature meanings, units and fill thresholds are not defined by the supplied dataset specification. The prediction is a Perceptron collection recommendation (Pickup or No pickup), not a measured fill percentage."
                                                   wrapText="true"
                                                   styleClass="disclaimer"/>
                                        </VBox>
                                    </VBox>
                                </content>
                            </ScrollPane>
                        </content>
                    </Tab>

                    <Tab text="Route Planning">
                        <content>
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                                <content>
                                    <VBox spacing="18" styleClass="tab-content">
                                        <Label text="Route Planning" styleClass="panel-title"/>
                                        <VBox styleClass="panel" spacing="12">
                                            <Label text="Create bins" styleClass="panel-title"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label text="Bin count" styleClass="field-caption"/>
                                                <TextField fx:id="binCountField" text="10" prefWidth="90"/>
                                                <Button text="Create Bins" onAction="#createBins" styleClass="secondary-button"/>
                                            </HBox>
                                            <Label text="Edit each bin ID and its three readings below." styleClass="section-description"/>
                                            <GridPane hgap="8" vgap="4">
                                                <Label text="Bin" styleClass="field-caption" GridPane.columnIndex="0"/>
                                                <Label text="ID" styleClass="field-caption" GridPane.columnIndex="1"/>
                                                <Label text="Reading 1" styleClass="field-caption" GridPane.columnIndex="2"/>
                                                <Label text="Reading 2" styleClass="field-caption" GridPane.columnIndex="3"/>
                                                <Label text="Reading 3" styleClass="field-caption" GridPane.columnIndex="4"/>
                                            </GridPane>
                                            <VBox fx:id="binsEditorBox" spacing="6"/>
                                        </VBox>
                                        <VBox styleClass="panel" spacing="12">
                                            <Label text="Simulated Annealing settings" styleClass="panel-title"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label text="Initial temperature" styleClass="field-caption"/>
                                                <TextField fx:id="initialTemperatureField" text="60" prefWidth="90"/>
                                                <Label text="Cooling rate" styleClass="field-caption"/>
                                                <TextField fx:id="coolingRateField" text="0.997" prefWidth="90"/>
                                                <Button text="Plan Route" onAction="#planRoute" styleClass="primary-button"/>
                                            </HBox>
                                            <Label fx:id="routeSummaryLabel" text="Create bins, train the model, then plan a route." wrapText="true" styleClass="status-message"/>
                                        </VBox>
                                        <VBox styleClass="panel" spacing="12">
                                            <Label text="Bin predictions" styleClass="panel-title"/>
                                            <VBox fx:id="routePredictionsBox" spacing="5"/>
                                        </VBox>
                                        <VBox styleClass="panel" spacing="12">
                                            <Label text="Best route" styleClass="panel-title"/>
                                            <Label text="The route starts and ends at DEPOT and includes pickup bins only." styleClass="section-description" wrapText="true"/>
                                            <Pane fx:id="routeMapPane" prefWidth="640" prefHeight="320" styleClass="route-map"/>
                                            <HBox spacing="16" alignment="CENTER_LEFT">
                                                <Label text="● Pickup bin" styleClass="pickup-legend"/>
                                                <Label text="○ Other bin" styleClass="other-legend"/>
                                                <Label text="■ Depot" styleClass="depot-legend"/>
                                            </HBox>
                                            <LineChart fx:id="distanceChart" animated="false" createSymbols="false" legendVisible="true" prefHeight="320">
                                                <xAxis><NumberAxis label="Iteration"/></xAxis>
                                                <yAxis><NumberAxis label="Distance (m)"/></yAxis>
                                            </LineChart>
                                        </VBox>
                                    </VBox>
                                </content>
                            </ScrollPane>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
